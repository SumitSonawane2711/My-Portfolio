generator client {
  provider        = "prisma-client"
  previewFeatures = ["relationJoins"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum ResumeStatus {
  ACTIVE // listed on the portfolio
  UNLISTED // reachable only by its direct link
  ARCHIVED // hidden everywhere, kept for history
}

/// Which site a contact message came from.
enum MessageSource {
  PORTFOLIO
  FREELANCE
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

// ─────────────────────────── Media ───────────────────────────

/// Every file uploaded to Cloudinary. Other tables point here.

model MediaAsset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  /// Cloudinary resource type. PDFs are uploaded as "image" so page thumbnails work.
  resourceType String   @default("image")
  format       String?
  width        Int?
  height       Int?
  bytes        Int?
  alt          String?
  createdAt    DateTime @default(now())

  projectCovers      Project[]           @relation("ProjectCover")
  projectImages      ProjectImage[]
  projectVideos      Project[]           @relation("ProjectPreviewVideo")
  experienceLogos    Experience[]        @relation("ExperienceLogo")
  testimonialAvatars Testimonial[]       @relation("TestimonialAvatar")
  technologyIcons    Technology[]        @relation("TechnologyIcon")
  resumes            Resume[]
  settingsAvatars    SiteSettings[]      @relation("SettingsAvatar")
  settingsOgImages   SiteSettings[]      @relation("SettingsOgImage")
  freelancePortraits FreelanceSettings[] @relation("FreelancePortrait")
  freelanceOgImages  FreelanceSettings[] @relation("FreelanceOgImage")

  @@index([createdAt])
}

// ──────────────────────── Technologies ───────────────────────

model Technology {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  /// Iconify key, e.g. "tabler:brand-react" or "logos:prisma"
  icon         String?
  customIconId String?
  customIcon   MediaAsset?  @relation("TechnologyIcon", fields: [customIconId], references: [id], onDelete: SetNull)
  /// Brand color used to tint single-color icons, e.g. "#61DAFB"
  color        String?
  order        Int          @default(0)
  projects     Project[]
  experiences  Experience[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([order])
}

// ────────────────────────── Projects ─────────────────────────

model Project {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  subtitle       String?
  summary        String
  /// Free-text date shown on cards, e.g. "July 2026"
  displayDate    String?
  coverId        String?
  cover          MediaAsset?    @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  images         ProjectImage[]
  /// Short silent screen recording, looped on the /freelance Work card.
  previewVideoId String?
  previewVideo   MediaAsset?    @relation("ProjectPreviewVideo", fields: [previewVideoId], references: [id], onDelete: SetNull)
  /// Tiptap JSON (editor source of truth)
  contentJson    Json?
  /// Sanitized + highlighted HTML (what visitors see)
  contentHtml    String         @default("")
  toc            Json           @default("[]")
  liveUrl        String?
  repoUrl        String?
  featured       Boolean        @default(false)
  published      Boolean        @default(false)
  /// Shown on the developer portfolio (home, /projects and its own page).
  portfolio      Boolean        @default(true)
  /// Shown on /freelance: the first three (project order) in the Work carousel, all on /freelance/work.
  freelance      Boolean        @default(false)
  /// Freelance caption: "<client> – <outcome>"
  clientName     String?
  outcome        String?
  order          Int            @default(0)
  seoTitle       String?
  seoDescription String?
  technologies   Technology[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([published, order])
}

model ProjectImage {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String?
  order     Int        @default(0)

  @@unique([projectId, mediaId])
  @@index([projectId, order])
}

// ─────────────────── Professional experience ─────────────────

model Experience {
  id           String       @id @default(cuid())
  company      String
  slug         String       @unique
  role         String
  companyUrl   String?
  logoId       String?
  logo         MediaAsset?  @relation("ExperienceLogo", fields: [logoId], references: [id], onDelete: SetNull)
  location     String?
  startDate    DateTime
  /// null = "Present"
  endDate      DateTime?
  /// Card text on the home page
  summary      String
  contentJson  Json?
  contentHtml  String       @default("")
  published    Boolean      @default(true)
  technologies Technology[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([published, startDate])
}

// ──────────────────────── Testimonials ───────────────────────

model Testimonial {
  id          String      @id @default(cuid())
  name        String
  role        String?
  company     String?
  avatarId    String?
  avatar      MediaAsset? @relation("TestimonialAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  quote       String
  linkedinUrl String?
  /// Private: where/when you received it (never shown publicly)
  sourceNote  String?
  visible     Boolean     @default(true)
  /// Also shown on /freelance.
  freelance   Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([visible, order])
}

// ─────────────────── Site settings (one row) ─────────────────

model SiteSettings {
  id               Int         @id @default(1)
  name             String      @default("")
  siteTitle        String      @default("Full Stack Developer Portfolio")
  siteDescription  String      @default("")
  heroHeading      String      @default("")
  heroSubheading   String      @default("")
  /// Short line on the profile card
  summary          String      @default("")
  about            String      @default("")
  avatarId         String?
  avatar           MediaAsset? @relation("SettingsAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  ogImageId        String?
  ogImage          MediaAsset? @relation("SettingsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  contactEmail     String?
  phone            String?
  location         String?
  availableForWork Boolean     @default(false)
  /// [{ "platform": "github", "url": "https://github.com/…" }, …]
  socials          Json        @default("[]")
  /// Last successful Medium RSS sync (shown in admin).
  mediumSyncedAt   DateTime?
  updatedAt        DateTime    @updatedAt
}

// ─────────────────────────── Resumes ─────────────────────────

model Resume {
  id            String       @id @default(cuid())
  /// Shown on the portfolio, e.g. "Full-stack Developer"
  title         String
  /// Stable public URL: /resume/<slug>. Survives file replacements.
  slug          String       @unique
  description   String?
  fileId        String
  file          MediaAsset   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  /// Download name, e.g. "Sumit_Sonawane_FullStack_2026.pdf"
  fileName      String
  status        ResumeStatus @default(ACTIVE)
  /// The default resume (hero/profile "Resume" button, /resume). At most one.
  isPrimary     Boolean      @default(false)
  order         Int          @default(0)
  downloadCount Int          @default(0)
  /// Private notes (target role, who received it, …)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, order])
}

// ───────────────────────── Medium posts ──────────────────────

enum MediumPostSource {
  RSS // synced from the Medium RSS feed (latest ~10 stories)
  MANUAL // added by hand in admin (older stories)
}

/// Stories published on Medium. The portfolio lists them and links out; there
/// is no on-site article page.
model MediumPost {
  id          String           @id @default(cuid())
  /// Medium's stable story id (RSS guid, e.g. https://medium.com/p/62edea66ffa4);
  /// the canonical URL for manual posts. Sync upserts on this.
  guid        String           @unique
  url         String
  title       String
  excerpt     String           @default("")
  coverUrl    String?
  tags        String[]
  publishedAt DateTime
  source      MediumPostSource @default(RSS)
  /// Hidden posts stay hidden across syncs.
  hidden      Boolean          @default(false)
  /// Featured posts come first on the home page.
  featured    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([hidden, publishedAt])
}

// ──────────────────── Inbox: contact messages ────────────────────

model Message {
  id        String        @id @default(cuid())
  status    MessageStatus @default(UNREAD)
  source    MessageSource @default(PORTFOLIO)
  name      String?
  email     String?
  /// International format, e.g. "+919876543210"
  phone     String?
  message   String
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ───────────────────────── Rate limit ────────────────────────

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────── Freelance one-pager (/freelance) ─────────────────────
// Copy fields support **bold** and blank-line paragraphs.

/// Page copy, contact options and SEO for /freelance (one row, id 1).
model FreelanceSettings {
  id               Int         @id @default(1)
  greeting         String      @default("")
  headline         String      @default("")
  intro            String      @default("")
  workTitle        String      @default("")
  workIntro        String      @default("")
  servicesTitle    String      @default("")
  servicesIntro    String      @default("")
  aboutTitle       String      @default("")
  about            String      @default("")
  portraitId       String?
  portrait         MediaAsset? @relation("FreelancePortrait", fields: [portraitId], references: [id], onDelete: SetNull)
  processTitle     String      @default("")
  processIntro     String      @default("")
  offersTitle      String      @default("")
  contactTitle     String      @default("")
  contactIntro     String      @default("")
  /// e.g. "Taking on new projects from November 2026"
  availabilityNote String      @default("")
  /// Digits with country code (e.g. 919876543210). "Message now" opens WhatsApp when set.
  whatsapp         String?
  seoTitle         String      @default("")
  seoDescription   String      @default("")
  ogImageId        String?
  ogImage          MediaAsset? @relation("FreelanceOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  updatedAt        DateTime    @updatedAt
}

/// "What I do": the numbered accordion.
model FreelanceService {
  id        String   @id @default(cuid())
  title     String
  /// Always visible under the title.
  summary   String
  /// Shown when the item is open.
  details   String   @default("")
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

/// "Ways to begin": engagement options with a "What you will get" list.
model FreelanceOffer {
  id           String   @id @default(cuid())
  name         String
  /// Small label, e.g. "Most popular"
  badge        String?
  tagline      String   @default("")
  description  String   @default("")
  deliverables String[]
  visible      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([visible, order])
}

// ─────────────────────── Live visitors ───────────────────────

enum VisitorSite {
  PORTFOLIO
  FREELANCE
}

/// One row per visitor with a tab open on a site, refreshed by a heartbeat.
/// "Live now" = rows seen in the last minute. No personal data: the id is a
/// salted hash of the IP, browser and site.
model LiveVisitor {
  id       String      @id
  site     VisitorSite
  lastSeen DateTime    @default(now())

  @@index([site, lastSeen])
}
