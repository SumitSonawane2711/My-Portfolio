# Single environment file for this project — copy to `.env` and fill in.
# Server-only unless prefixed NEXT_PUBLIC_. Validated by src/shared/configs/env.ts.

# ── Database (Neon) ──────────────────────────────────────────
# Pooled (host contains -pooler) for the app, direct for Prisma migrations.
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Better Auth + GitHub) ──────────────────────────────
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
ADMIN_EMAIL="you@example.com"    # the only GitHub account allowed into /admin

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Cloudinary ───────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="portfolio"

# ── Turnstile (Cloudflare test keys shown — they always pass) ─
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ── Privacy ──────────────────────────────────────────────────
HASH_SALT=""                     # openssl rand -hex 32

# ── Email (Gmail app password) — contact + inbox notifications
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""            # Google Account → Security → App passwords
CONTACT_RECEIVER_EMAIL=""        # optional; defaults to GMAIL_USER

# Daily Medium sync (vercel.json cron). Vercel sends it as a Bearer token.
CRON_SECRET=""                   # optional locally; openssl rand -hex 32
