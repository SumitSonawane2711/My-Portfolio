# Runs before every `git push`.
#   → main          : always blocked (open a PR from dev instead)
#   → dev           : full CI checks, so the push doesn't fail on GitHub
#   → anything else : no checks (feature branches push freely)
# Emergency bypass (CI still checks everything): git push --no-verify

zero="0000000000000000000000000000000000000000"
checks_dev=0

if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
  echo "✖ Direct pushes from main are not allowed. Open a PR from dev."
  exit 1
fi

# Git passes one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch

  case "$remote_ref" in
    refs/heads/main)
      echo "✖ Pushing to main is not allowed. Open a PR from dev."
      exit 1
      ;;
    refs/heads/dev)
      checks_dev=1
      # Commit messages of everything being pushed (CI checks these on pull
      # requests; this also catches commits made with --no-verify).
      if [ "$remote_sha" = "$zero" ]; then
        from="$(git merge-base origin/main "$local_sha" 2>/dev/null)"
      else
        from="$remote_sha"
      fi
      # Skip when there's nothing new (from = to gives commitlint an empty range).
      if [ -n "$from" ] && [ "$from" != "$local_sha" ]; then
        npx --no -- commitlint --from "$from" --to "$local_sha" || exit 1
      fi
      ;;
  esac
done

[ "$checks_dev" = "1" ] || exit 0

# The checks run on your working copy, but only commits are pushed: an
# uncommitted or untracked file could make them pass here and CI fail.
if [ -n "$(git status --porcelain)" ]; then
  echo "✖ You have uncommitted or untracked changes:"
  git status --short
  echo "  Commit them (or stash them with: git stash -u) and push again, so the"
  echo "  checks test exactly what you push."
  exit 1
fi

# Everything CI runs: lint, format, prisma, typecheck, tests, build.
node scripts/verify.mjs
